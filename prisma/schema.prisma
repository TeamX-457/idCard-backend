// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
}

model School {
  id           String   @id @default(uuid())
  name         String
  address      String?
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users    User[]
  students Student[]

  @@map("schools")
  cards   Card[]
  devices Device[]
}


model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  status       String   @default("active")
  schoolId     String?  @map("school_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school School? @relation(fields: [schoolId], references: [id])

  @@map("users")
}

model Student {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  name            String
  class           String
  admissionNumber String   @map("admission_number")
  status          String   @default("active")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id])
  guardians StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([admissionNumber])
  @@map("students")
  cards            Card[]
  attendanceEvents AttendanceEvent[]
}


model Guardian {
  id                     String   @id @default(uuid())
  name                   String
  phoneNumber            String   @map("phone_number")
  notificationPreference String   @default("sms") @map("notification_preference")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  students StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  guardianId   String   @map("guardian_id")
  relationship String
  createdAt    DateTime @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model Card {
  id         String    @id @default(cuid())
  uid        String
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  status     String    // "active" | "revoked"
  issuedAt   DateTime  @default(now())
  revokedAt  DateTime?
  attendanceEvents AttendanceEvent[]

  @@index([schoolId, uid])
  @@map("cards")
}

model Device {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  locationName String
  latitude     Float?
  longitude    Float?
  secretHash   String
  status       String   // "active" | "disabled"
  createdAt    DateTime @default(now())
  attendanceEvents AttendanceEvent[]

  @@map("devices")
}

model AttendanceEvent {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  cardId         String
  card           Card     @relation(fields: [cardId], references: [id])
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id])
  eventType      String   // "check_in" | "check_out"
  timestamp      DateTime @default(now())
  readerLocation String

  @@map("attendance_events")
}