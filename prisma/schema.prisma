// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
}

model School {
  id           String   @id @default(uuid())
  name         String
  address      String?
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users    User[]
  students Student[]

  @@map("schools")
  cards   Card[]
  devices Device[]
  attendanceRule AttendanceRule?
  dailyAttendanceStatuses DailyAttendanceStatus[]
  calendarExceptions SchoolCalendarException[]
  terms SchoolTerm[]
}


model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  status       String   @default("active")
  schoolId     String?  @map("school_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school School? @relation(fields: [schoolId], references: [id])

  @@map("users")
}

model Student {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  name            String
  class           String
  admissionNumber String   @map("admission_number")
  status          String   @default("active")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id])
  guardians StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([admissionNumber])
  @@map("students")
  cards            Card[]
  attendanceEvents AttendanceEvent[]
  dailyAttendanceStatuses DailyAttendanceStatus[]
}


model Guardian {
  id                     String   @id @default(uuid())
  name                   String
  phoneNumber            String   @map("phone_number")
  notificationPreference String   @default("sms") @map("notification_preference")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  students StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  guardianId   String   @map("guardian_id")
  relationship String
  createdAt    DateTime @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@map("student_guardians")
}

model Card {
  id         String    @id @default(cuid())
  uid        String
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  status     String    // "active" | "revoked"
  issuedAt   DateTime  @default(now())
  revokedAt  DateTime?
  attendanceEvents AttendanceEvent[]

  @@index([schoolId, uid])
  @@map("cards")
}

model Device {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  locationName String
  latitude     Float?
  longitude    Float?
  secretHash   String
  status       String   // "active" | "disabled"
  createdAt    DateTime @default(now())
  attendanceEvents AttendanceEvent[]

  @@map("devices")
}

model AttendanceEvent {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  cardId         String
  card           Card     @relation(fields: [cardId], references: [id])
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id])
  eventType      String
  timestamp      DateTime @default(now())
  readerLocation String
  idempotencyKey String   @unique @map("idempotency_key")

  @@map("attendance_events")
}

model AttendanceRule {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  school          School   @relation(fields: [schoolId], references: [id])
  earlyThreshold  Int      @default(480) // "time to mark early" — 8:00, before this = early
  presentThreshold Int     @default(540) // "time to mark present" — 9:00, up to this = present, after = late
  absentThreshold Int      @default(900) // "time to mark absent" — 15:00, no check-in by this time = absent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  schoolDays Int[] @default([1, 2, 3, 4, 5])

  @@map("attendance_rules")
}

model DailyAttendanceStatus {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  date      DateTime 
  status    String   // "early" | "present" | "late" | "absent"
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@map("daily_attendance_statuses")
}

model SchoolTerm {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   // "First Term 2026", "Second Term 2026/2027"
  startDate DateTime
  endDate   DateTime

  @@map("school_terms")
}

model SchoolCalendarException {
  id       String   @id @default(cuid())
  schoolId String
  school   School   @relation(fields: [schoolId], references: [id])
  date     DateTime
  type     String
  label    String

  @@unique([schoolId, date])
  @@map("school_calendar_exceptions")
}